{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decklet model",
  "description": "The JSON model bin/create.mjs builds into one deck.html. Structure and enums only: bin/validate.mjs checks fit, air, density, coverage and the rest.",
  "type": "object",
  "required": [
    "slides"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "w": {
      "type": "number"
    },
    "h": {
      "type": "number"
    },
    "format": {
      "enum": [
        "slides",
        "carousel",
        "carousel-4x5",
        "document-letter",
        "document-a4",
        "slides-4x3",
        "story",
        "document-letter-landscape",
        "document-a4-landscape",
        "poster-a3"
      ]
    },
    "page": {
      "enum": [
        "letter",
        "a4",
        "letter-landscape",
        "a4-landscape",
        "a3"
      ]
    },
    "title": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "rev": {
      "type": "string"
    },
    "spell": {
      "type": "object",
      "properties": {
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "counter": {
      "const": 0
    },
    "density": {
      "enum": [
        "speaker",
        "reading"
      ]
    },
    "draft": {
      "type": "boolean"
    },
    "styles": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "object",
          "description": "the eight text roles (plus the optional Stat2): the whole type system",
          "properties": {
            "Title": {
              "$ref": "#/$defs/role"
            },
            "Supertitle": {
              "$ref": "#/$defs/role"
            },
            "H1": {
              "$ref": "#/$defs/role"
            },
            "H2": {
              "$ref": "#/$defs/role"
            },
            "Body": {
              "$ref": "#/$defs/role"
            },
            "Caption": {
              "$ref": "#/$defs/role"
            },
            "Label": {
              "$ref": "#/$defs/role"
            },
            "Stat": {
              "$ref": "#/$defs/role"
            },
            "Stat2": {
              "$ref": "#/$defs/role"
            }
          }
        },
        "margin": {
          "type": "number"
        },
        "pad": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "gap": {
          "type": "number"
        }
      }
    },
    "slots": {
      "type": "object"
    },
    "layouts": {
      "type": "object"
    },
    "master": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^data:"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": [
        "font",
        "size",
        "weight",
        "color"
      ],
      "properties": {
        "font": {
          "type": "string",
          "description": "a font stack: an installed or system family first, a generic fallback last; the deck loads no webfonts"
        },
        "size": {
          "type": "number",
          "description": "model px"
        },
        "weight": {
          "type": [
            "number",
            "string"
          ]
        },
        "lh": {
          "type": [
            "number",
            "null"
          ],
          "description": "line height, model px"
        },
        "ls": {
          "type": "number",
          "description": "letter spacing, model px"
        },
        "color": {
          "type": "string"
        },
        "tt": {
          "type": "string",
          "description": "text-transform, e.g. uppercase"
        },
        "cw": {
          "type": "number",
          "description": "measured average glyph width in em (bin/measure-cw.mjs)"
        }
      }
    },
    "row": {
      "type": "object",
      "description": "a row is whatever its props make it: text, a painted box, a line, a connector, an image, a logo, a chart",
      "properties": {
        "id": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "right": {
          "type": "number",
          "description": "the right edge N px from the canvas right edge; exclusive with x"
        },
        "w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "const": "auto"
            }
          ]
        },
        "h": {
          "type": "number"
        },
        "slot": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "a role from styles.roles; required for text"
        },
        "text": {
          "type": "string"
        },
        "html": {
          "type": "string",
          "description": "inline runs only: <b> <i> <u> <s> <span style=\"color:…\"> <a href=\"…\">"
        },
        "weight": {
          "type": [
            "number",
            "string"
          ]
        },
        "color": {
          "type": "string"
        },
        "tt": {
          "type": "string"
        },
        "italic": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "valign": {
          "enum": [
            "middle",
            "bottom"
          ]
        },
        "nowrap": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "bullet": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "ws": {
          "type": "string"
        },
        "p": {
          "type": [
            "string",
            "number"
          ]
        },
        "bg": {
          "type": "string"
        },
        "bd": {
          "type": "string"
        },
        "bt": {
          "type": "string"
        },
        "br": {
          "type": "string"
        },
        "bb": {
          "type": "string"
        },
        "bl": {
          "type": "string"
        },
        "radius": {
          "type": [
            "number",
            "string"
          ]
        },
        "shadow": {
          "type": "string"
        },
        "op": {
          "type": "number"
        },
        "box": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "tile": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "bar": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "line": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "description": "[x2, y2]"
        },
        "curve": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "description": "[c1x, c1y, c2x, c2y, x2, y2]"
        },
        "arrow": {
          "enum": [
            "start",
            "end",
            "both"
          ]
        },
        "to": {
          "type": [
            "string",
            "integer"
          ]
        },
        "from": {
          "type": [
            "string",
            "integer"
          ]
        },
        "gap": {
          "type": "number"
        },
        "after": {
          "type": [
            "string",
            "integer"
          ]
        },
        "style": {
          "enum": [
            "arrow",
            "dashed",
            "blocked"
          ],
          "description": "a connector row: {from, to, style}"
        },
        "head": {
          "enum": [
            "triangle",
            "chevron",
            "dot",
            "bar"
          ]
        },
        "dash": {
          "anyOf": [
            {
              "type": [
                "integer",
                "boolean"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2
            }
          ]
        },
        "waive": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "over": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "butt": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "href": {
          "type": "string",
          "description": "http/https/mailto, or #n / #slide-id into the deck"
        },
        "donut": {
          "type": "number"
        },
        "hole": {
          "type": "number"
        },
        "svg": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "a Lucide icon name (validate --icons)"
        },
        "img": {
          "type": "string",
          "description": "a data: URI or '#id' naming deck.assets"
        },
        "fit": {
          "type": "string"
        },
        "pos": {
          "type": "string"
        },
        "logo": {
          "type": "string",
          "description": "a data: URI, '#id' or '' for a monogram"
        },
        "name": {
          "type": "string"
        },
        "col": {
          "type": "number"
        },
        "aspect": {
          "type": "number"
        },
        "plate": {
          "enum": [
            "auto",
            "light",
            "dark",
            "none",
            "any"
          ]
        },
        "monogram": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "anim": {
          "enum": [
            "rise",
            "fade",
            "pop",
            "wipe"
          ]
        },
        "chart": {
          "type": "object",
          "properties": {
            "mark": {
              "enum": [
                "bar",
                "line",
                "hbar"
              ]
            },
            "data": {
              "type": "array"
            }
          }
        },
        "css": {
          "type": "string"
        },
        "override": {
          "type": "string",
          "description": "a master id: only the props this row carries replace the master on this slide"
        },
        "footer": {
          "type": [
            "integer",
            "boolean"
          ]
        },
        "placeholder": {
          "type": "string"
        }
      }
    },
    "slide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "layout": {
          "type": "string",
          "description": "a deck layout or one of the library layouts (validate --layouts)"
        },
        "bg": {
          "type": "string"
        },
        "hide": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "textOnly": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "summary"
          ]
        },
        "density": {
          "enum": [
            "speaker",
            "reading"
          ]
        },
        "template": {
          "enum": [
            "cover-hero",
            "cover-split",
            "section-numeral",
            "agenda-ruled",
            "bullet-page",
            "exec-summary",
            "quote-pull",
            "statement",
            "closing-cta",
            "stat-hero",
            "stat-row-3",
            "stat-row-4",
            "kpi-scorecard",
            "stat-plus-chart",
            "delta-pair",
            "progress-tracker",
            "two-col-compare",
            "pros-cons",
            "benchmark-table",
            "harvey-balls",
            "area-bubbles",
            "area-bubbles-speaker",
            "waffle",
            "waffle-speaker",
            "range-bar",
            "range-bar-speaker",
            "two-by-two",
            "swot",
            "temple",
            "venn-3",
            "pyramid-layers",
            "scorecard-grid",
            "value-chain",
            "process-flow-3",
            "process-flow-4",
            "process-flow-5",
            "timeline-horizontal",
            "gantt-lanes",
            "vertical-steps",
            "cycle-loop",
            "funnel-stages",
            "chart-column",
            "chart-bar-ranked",
            "chart-stacked-100",
            "chart-grouped",
            "chart-line-trend",
            "chart-area-band",
            "chart-waterfall",
            "chart-donut",
            "chart-donut-row",
            "chart-gauge",
            "chart-scatter",
            "chart-heatmap",
            "chart-histogram",
            "chart-slope",
            "chart-dumbbell",
            "chart-small-multiples",
            "chart-marimekko",
            "chart-pareto",
            "bento-grid",
            "image-hero-overlay",
            "image-split",
            "image-bullets",
            "annotated-shot",
            "three-up-cards",
            "dashboard-composite",
            "table-panel",
            "table-insight",
            "proof-strip",
            "team-grid",
            "figure-decision",
            "figure-flow",
            "figure-before-after",
            "figure-data-model",
            "figure-states",
            "figure-release",
            "figure-boundaries",
            "figure-boundaries-6",
            "figure-tree",
            "figure-layers",
            "chrome-foot-band",
            "chrome-hairline-foot",
            "chrome-header-kicker",
            "chrome-side-rail",
            "chrome-tabs",
            "chrome-dots",
            "chrome-brand-bar",
            "chrome-none",
            "pad-tight-40",
            "pad-default-60",
            "pad-generous-96",
            "pad-asymmetric-rail",
            "density-speaker",
            "density-reading",
            "quad-growth-share",
            "quad-effort-impact",
            "quad-risk-heat",
            "quad-stakeholder",
            "quad-movement",
            "quad-where-we-play",
            "quad-conceptual",
            "quad-nine-box",
            "quad-with-panel",
            "logo-corner-mark",
            "logo-foot-mark",
            "logo-cover-lockup",
            "logo-co-brand",
            "logo-rail-mark",
            "logo-watermark",
            "icon-three-up",
            "icon-capability-grid",
            "icon-bullets",
            "logo-proof-wall",
            "logo-top-right-mark",
            "logo-top-right-lockup",
            "logo-top-right-badge"
          ],
          "description": "a library template (validate --templates)"
        },
        "fill": {
          "type": "object"
        },
        "els": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    }
  }
}
