{
  "name": "@grunion/decklet",
  "version": "0.3.4",
  "description": "Claude Code and Codex skill plus CLI that turns any content into one self-contained, hand-editable HTML slide deck: brand-true type roles, drag-and-retype editor, in-file PDF, verified layout, zero dependencies. Open-source alternative to PowerPoint, Gamma and PPTX-generator skills.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "decklet-create": "bin/create.mjs",
    "decklet-validate": "bin/validate.mjs",
    "decklet-verify": "bin/verify.mjs",
    "decklet-import-html": "bin/import-html.mjs"
  },
  "files": [
    "deck.html",
    "template.html",
    "bin",
    "lib",
    "examples",
    "SKILL.md",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "test:live": "npx playwright install chromium && node --test test/**/*.test.mjs",
    "build:deck": "node bin/create.mjs --model examples/explainer/model.json --out deck.html --title decklet",
    "verify:deck": "node bin/verify.mjs deck.html"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "keywords": [
    "slides",
    "presentation",
    "deck",
    "single-file",
    "html",
    "editable",
    "agent",
    "llm",
    "claude-code",
    "skill",
    "carousel",
    "one-pager",
    "pdf",
    "zero-dependency",
    "claude-skill",
    "claude-code-skill",
    "agent-skills",
    "codex",
    "powerpoint-alternative",
    "ai-slides",
    "presentation-generator"
  ],
  "homepage": "https://grunion-ai.github.io/decklet/deck.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/grunion-ai/decklet.git"
  }
}
