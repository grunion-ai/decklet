        {
          "slot": "n5",
          "text": "05"
        },
        {
          "slot": "item5",
          "text": "Replace · section 5 in five words"
        },
        {
          "slot": "note",
          "text": "Replace with the one sentence that frames the list."
        }
      ]
    },
    {
