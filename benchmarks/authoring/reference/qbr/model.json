{
  "$schema": "../../../../home/user/wt-bench/schemas/model.schema.json",
  "title": "Meridian Freight — PLACEHOLDER deck",
  "format": "slides",
  "w": 960,
  "h": 540,
  "density": "reading",
  "styles": {
