      "layout": "chart",
      "els": [
        {
          "slot": "supertitle",
          "text": "TREND"
        },
        {
          "slot": "title",
          "text": "Replace with what the series shows."
        },
        {
          "slot": "chart",
          "chart": {
            "mark": "bar",
            "data": [
              {
                "label": "One",
                "value": 10
