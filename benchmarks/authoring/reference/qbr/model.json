        },
        {
          "slot": "caption",
          "text": "Replace · presenter, audience, date"
        }
      ]
    },
    {
      "name": "agenda",
      "layout": "agenda",
      "els": [
        {
          "slot": "supertitle",
          "text": "AGENDA"
        },
        {
          "slot": "title",
          "text": "Replace with what the deck covers."
        },
        {
          "slot": "n1",
          "text": "01"
        },
        {
          "slot": "item1",
          "text": "Replace · section 1 in five words"
        },
        {
          "slot": "n2",
          "text": "02"
        },
        {
          "slot": "item2",
          "text": "Replace · section 2 in five words"
        },
